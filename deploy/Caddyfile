# Reverse proxy for the staging Next.js process on the Hetzner VPS.
# Caddy handles automatic HTTPS (ACME) with no extra config needed.
#
# This VPS runs a shared top-level /etc/caddy/Caddyfile that imports
# per-site snippets, so install this as /etc/caddy/wiki.caddy and add
# `import /etc/caddy/wiki.caddy` to the top level of the main Caddyfile,
# then `sudo systemctl reload caddy`.
wiki.igemlund.org {
    encode zstd gzip

    # Explicit Host/X-Forwarded-Proto: keystatic-admin/route.ts reads these
    # to work out the app's real public origin for GitHub OAuth (Next's own
    # request.url ignores Host and reports its own bind address under
    # `next start` — see the comment there for the full story).
    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
    }

    log {
        output file /var/log/caddy/igem-wiki-access.log
    }

    # Optional extra layer on top of Keystatic's own GitHub OAuth gate for
    # /edit. Uncomment and set credentials via `caddy hash-password` if
    # the team wants defense-in-depth on a publicly reachable VPS.
    # @keystaticAdmin path /edit* /api/keystatic*
    # basicauth @keystaticAdmin {
    #     <username> <bcrypt-hash>
    # }
}
