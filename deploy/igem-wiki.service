# systemd unit for the staging Next.js process on the Hetzner VPS.
# Install at /etc/systemd/system/igem-wiki.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now igem-wiki
#
# Deploy/update flow is automatic: a self-hosted GitHub Actions runner lives
# on this same box (see .github/workflows/deploy-staging.yml), running as the
# `marin` user. On every push to main it builds into a fresh
# /srv/igem-wiki/releases/<sha>, and only after that succeeds repoints the
# /srv/igem-wiki/current symlink (WorkingDirectory below) and runs
# `sudo systemctl restart igem-wiki` (marin already has passwordless sudo on
# this box, so no extra sudoers rule is needed). The running server is never
# touched mid-build. .env.staging lives outside the releases so it survives
# across runs untouched.
#
# `current` does not exist until the first deploy under this layout finishes,
# so install this unit with `daemon-reload` only (no restart); the workflow
# restarts it.
[Unit]
Description=iGEM Lund 2026 Wiki - staging Next.js server
After=network.target

[Service]
Type=simple
User=marin
WorkingDirectory=/srv/igem-wiki/current
Environment=BUILD_TARGET=staging
Environment=PORT=3000
EnvironmentFile=-/srv/igem-wiki/.env.staging
ExecStart=/usr/bin/npm run start:staging
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/igem-wiki/out.log
StandardError=append:/var/log/igem-wiki/err.log

[Install]
WantedBy=multi-user.target
