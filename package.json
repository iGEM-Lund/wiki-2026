{
  "name": "igem-wiki",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/keystatic-routes.mjs link",
    "dev": "next dev",
    "prebuild:staging": "node scripts/keystatic-routes.mjs link",
    "build:staging": "npm run prebuild:staging && cross-env BUILD_TARGET=staging next build",
    "start:staging": "cross-env BUILD_TARGET=staging next start -p 3000",
    "prebuild": "node scripts/keystatic-routes.mjs unlink",
    "build": "npm run prebuild && cross-env BUILD_TARGET=production next build",
    "deploy:production": "bash scripts/deploy-production.sh",
    "typecheck": "tsc --noEmit",
    "generate:icons": "node scripts/generate-icon-names.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@keystatic/core": "^0.5.50",
    "@keystatic/next": "^5.0.4",
    "@mdx-js/mdx": "^3.1.1",
    "3dmol": "^2.5.5",
    "d3-geo": "^3.1.1",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.18.5",
    "lucide-react": "^1.26.0",
    "next": "^15.5.20",
    "openchemlib": "^9.25.0",
    "react": "^19.1.8",
    "react-dom": "^19.1.8",
    "rehype-slug": "^6.0.0",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "unist-util-visit-parents": "^6.0.2",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-simplify": "^3.0.3",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.0"
  }
}
