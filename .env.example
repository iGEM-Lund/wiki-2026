# Created via Keystatic's own /keystatic first-run setup flow, which walks
# you through creating a GitHub App scoped to the iGEM-Lund-2026/Wiki repo.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# BUILD_TARGET is intentionally NOT set here.
#   unset      -> local dev, Keystatic admin UI active (npm run dev)
#   staging    -> live Node process on the Hetzner VPS, Keystatic active (npm run build:staging / start:staging)
#   production -> static export for the iGEM GitLab mirror, Keystatic stripped (npm run build)
# Set BUILD_TARGET=staging in the VPS's .env.staging; leave unset for local dev.
# CI sets BUILD_TARGET=production itself — do not set it in a committed .env.
